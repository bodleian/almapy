# Copy to .env to run the integration tests. Not needed for the normal suite —
# `uv run pytest` passes with no API key and no network access.
#
# Get a key from the Ex Libris Developer Network (https://developers.exlibrisgroup.com):
# create an application, then add the Bibs / Users / Acquisitions / Configuration
# APIs to it with read-only permission unless you specifically need writes.
API_KEY=

# Repeat count for the adaptive-backpressure integration test.
INTEGRATION_REPEAT_COUNT=300

# Integration tests also need item barcodes at .testdata/barcodes.txt,
# one per line; lines starting with # are ignored.
